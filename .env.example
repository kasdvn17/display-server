PORT=8080
IMMICH_URL=https://photos.example.com
IMMICH_API_KEY=replace_me
NEWS_RSS_URL=https://news.google.com/rss?hl=en&gl=VN&ceid=VN:en
NEWS_LIMIT=20

# Spotify Premium / Web API / Web Playback SDK
# Create an app at https://developer.spotify.com/dashboard and enable Web API + Web Playback SDK.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify requires HTTPS here unless the redirect is a loopback IP (127.0.0.1 / ::1).
# For an iPad on your LAN, expose ONLY this Node app through an HTTPS hostname (for example a Cloudflare Tunnel)
# and register the exact callback URL in the Spotify dashboard.
SPOTIFY_REDIRECT_URI=https://display.example.com/spotify/callback

# Where the callback sends the browser after a successful authorization.
# This may be your LAN display URL if the iPad can reach it.
SPOTIFY_AFTER_LOGIN_URL=http://192.168.1.78:8080/?spotify=connected

# Refresh/access tokens are stored server-side here. Do not put this file in git.
SPOTIFY_TOKEN_FILE=.spotify-token.json
SPOTIFY_DEVICE_NAME=Nest Frame · iPad

# Ambient photo curator (Google Photos / Apple Photos style)
# Extra comma-separated album names/pattern fragments to exclude. Common iOS/utility albums are already excluded in server.js.
FRAME_EXCLUDE_ALBUMS=Downloads,WhatsApp Images,Camera,Telegram
FRAME_POOL_REFRESH_MS=1800000
FRAME_MAX_STORY_ASSETS=12
FRAME_MIN_EVENT_ASSETS=4
FRAME_MEMORY_WINDOW_DAYS=3
FRAME_UNALBUMED_LIMIT=1500
FRAME_MAX_ALBUMS=60

# Relative weights within PHOTO mode. News probability is configured in public/index.html.
FRAME_WEIGHT_ALBUMS=45
FRAME_WEIGHT_LOCATIONS=30
FRAME_WEIGHT_MEMORIES=20
FRAME_WEIGHT_DISCOVERY=5

# Front camera / WebRTC intercom
# Remote viewer page: https://nestframe.blam.id.vn/camera
# Use a long random secret; viewers must enter it before the iPad auto-answers.
CAMERA_REMOTE_TOKEN=change-this-to-a-long-random-secret

# STUN is enough on many networks. If remote viewing fails across CGNAT/NAT,
# configure a TURN server (for example coturn) below.
CAMERA_STUN_URL=stun:stun.l.google.com:19302
CAMERA_TURN_URL=
CAMERA_TURN_USERNAME=
CAMERA_TURN_CREDENTIAL=
CAMERA_CALL_TTL_MS=90000

# Ambient weather / air quality / commute context
# Optional fixed fallback coordinates. If blank, the iPad will ask Safari for its
# current location and send only the coordinates needed for each context refresh.
FRAME_LATITUDE=
FRAME_LONGITUDE=
FRAME_LOCATION_NAME=Current location
AMBIENT_CONTEXT_REFRESH_MS=300000

# Routing provider for commute estimates. The default public OSRM service is fine
# for light personal use; point this at your own OSRM instance if desired.
OSRM_BASE_URL=https://router.project-osrm.org

# JSON array of recurring commute destinations. days: 0=Sun ... 6=Sat.
# `arrival` is local clock time. `bufferMinutes` is subtracted in addition to travel time.
# Example:
# FRAME_COMMUTE_TARGETS=[{"id":"school","name":"School","lat":21.0285,"lon":105.8542,"arrival":"07:15","days":[1,2,3,4,5],"bufferMinutes":8}]
FRAME_COMMUTE_TARGETS=[]
# Calendar glance / event-aware commute
# Paste a private/public ICS feed URL here (Google Calendar: Settings -> Integrate calendar -> Secret address in iCal format).
# The feed is fetched only by this Node server and is never exposed to the browser.
FRAME_CALENDAR_ICS_URL=
FRAME_CALENDAR_NAME=Calendar
FRAME_TIMEZONE=Asia/Bangkok
FRAME_CALENDAR_LOOKAHEAD_HOURS=48

# For event-aware commute, add calendarMatch (string or array) to a commute target.
# When an upcoming calendar event title/location matches, its start time replaces the fixed `arrival` time.
# Example:
# FRAME_COMMUTE_TARGETS=[{"id":"school","name":"School","lat":21.0285,"lon":105.8542,"calendarMatch":["school","math","physics"],"arrival":"07:15","days":[1,2,3,4,5],"bufferMinutes":8}]

# Local list of Immich assets hidden from this frame only. Auto-created when you use "Hide from frame".
FRAME_HIDDEN_ASSETS_FILE=.frame-hidden-assets.json

# News image enrichment: the server checks article metadata for image/description when RSS does not provide one.
NEWS_IMAGE_ENRICH_LIMIT=12


# Remote control API
# Generate a long random token. Send it as: Authorization: Bearer <token>
# Endpoint: POST /remote/control
REMOTE_CONTROL_TOKEN=change-this-to-a-long-random-secret


# Gemini
GEMINI_API_KEY=replace_me